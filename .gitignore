# API 키·비밀 — 어떤 형태로도 저장소에 넣지 않는다 (환경변수 전용)
.env
.env.*
*.key
secrets/

# 파이썬
__pycache__/
*.pyc
# 프로젝트 전용 가상환경 (Pillow 전용 — tools/*.py 는 여전히 표준 라이브러리만 쓴다).
# 기기마다 다시 만드는 물건이라 추적하지 않는다: python -m venv .venv && .venv\Scripts\python -m pip install Pillow
.venv/

# 대용량 생성물 (원본은 별도 백업 권장)
images/raw/
output/
backups/

# 실행 로그 (서버 로그·MakeFun 사용 대장 — 기기 로컬 기록)
logs/

# 개인 대화 기록 — 인물과 나눈 사적 대화는 저장소에 올리지 않는다
project/story/chatlog.json
project/story/talk_*.json
# 통합 화면의 대화 갈래도 같은 사적 기록이다 (talk_store.story_chat_path_for).
# chatlog.json 한 줄만 있던 시절의 규칙이라 갈래 파일이 그대로 새어나갈 뻔했다.
project/story/chat_*.json
# 갈래별 설정(작품 문맥 사용 여부) — 대화 내용은 아니지만 사용 흔적이라 함께 뺀다.
project/story/chats_meta.json
# 낮에 담아 둔 착상 메모도 개인 기록이다 (앞으로 생길 자리를 미리 막아 둔다).
project/story/notes.json
# 상한(LOG_CAP)을 넘겨 이관된 대화 아카이브도 같은 사적 기록이다 (talk_store.archive_path).
# 확장자가 .jsonl 이라 위 두 줄에 걸리지 않는다 — 이 줄이 없으면 `git add .` 한 번에 커밋된다.
project/story/*.archive.jsonl
# 지운 대화의 보관 기록도 같다. 이름은 chat_x.deleted.archive.jsonl 이라 위 줄에 걸리지만,
# 예전에는 .deleted 를 뒤에 붙여 chat_x.archive.deleted.jsonl 이었고 그건 **걸리지 않았다**.
# 그 이름으로 이미 만들어진 파일이 어딘가 남아 있을 수 있으므로 한 줄 더 막아 둔다.
project/story/*.deleted.jsonl
# 그 대화를 압축한 기억 요약본도 같은 사적 기록이다 (prompt_build.save_memory_summary)
project/story/memory_*.json

# 재구성 백업 잔재 (backups/ 로 이관 전 과거 흔적)
project/scenes_backup_*/

# 작품 보관소(works.py) — **장면은 추적하고 그림은 안 한다.**
#
# 장면 JSON 은 이 저장소에서 유일한 집 밖 사본이다(그림은 원래 제외된다).
# 작품을 바꾸면 장면이 project/scenes/ 와 works/<id>/scenes/ 사이를 오가는데,
# 보관소를 제외해 버리면 쉬고 있는 작품의 장면은 **디스크에만** 남는다.
# 그래서 장면은 어느 자리에 있든 추적된다 — 전환은 git 이 보기에 파일 이동이다.
# 반면 그림은 images/ 와 같은 이유로 제외한다(150MB 가 커밋에 실리면 안 된다).
# 지금 어느 작품이 올라와 있는가 — 기계마다 다른 상태라 저장소에 싣지 않는다.
# (없으면 기본 대화의 작품이 올라있는 것으로 본다 — 새 기계에서도 바로 맞는다.)
project/works_state.json
project/works/*/images_raw/
# 지운 작품의 보관본도 통째로 제외(그림이 들어 있다).
project/works/*.deleted/
project/works/*.deleted-*/


# 붙여넣기용 장면 브리프 (scene_brief 가 매번 다시 만든다 — 추적할 이유가 없다)
project/scene_briefs/

# 로컬 사용자 설정·작업 잡파일
.claude/settings.local.json
scratch/
!scratch/.gitkeep
ai-webtoon-protocol-v5.1.zip
