# API 키·비밀 — 어떤 형태로도 저장소에 넣지 않는다 (환경변수 전용)
.env
.env.*
*.key
secrets/

# 파이썬
__pycache__/
*.pyc

# 대용량 생성물 (원본은 별도 백업 권장)
images/raw/
output/
backups/

# 실행 로그 (서버 로그·MakeFun 사용 대장 — 기기 로컬 기록)
logs/

# 개인 대화 기록 — 인물과 나눈 사적 대화는 저장소에 올리지 않는다
project/story/chatlog.json
project/story/talk_*.json
# 그 대화를 압축한 기억 요약본도 같은 사적 기록이다 (local_llm.save_memory_summary)
project/story/memory_*.json

# 재구성 백업 잔재 (backups/ 로 이관 전 과거 흔적)
project/scenes_backup_*/

# 로컬 사용자 설정·작업 잡파일
.claude/settings.local.json
scratch/
!scratch/.gitkeep
ai-webtoon-protocol-v5.1.zip
