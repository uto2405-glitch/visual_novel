{
  "name": "vn-studio",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "bin": "server.cjs",
  "pkg": {
    "assets": [
      "dist/**/*"
    ],
    "targets": [
      "node22-win-x64"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "serve": "node server.cjs",
    "make:exe": "npm run build && pkg . -o release/VN-Studio.exe",
    "lint": "eslint .",
    "verify:examples": "node examples/run.mjs",
    "lint:story": "node examples/lint-run.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@yao-pkg/pkg": "^6.22.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.1.0"
  }
}
